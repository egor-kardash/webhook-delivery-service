# HTTP Server (указаны значения по умолчанию)
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL (USER, PASSWORD, DB - обязательны)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable

# Delivery worker (указаны значения по умолчанию)
DELIVERY_POLL_INTERVAL=1s
DELIVERY_MAX_PER_TICK=5
DELIVERY_HTTP_TIMEOUT=5s
DELIVERY_LEASE=30s
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_DELAY=1s
DELIVERY_RETRY_MAX_DELAY=1m

# Logging (указаны значения по умолчанию)
LOG_LEVEL=info
LOG_FORMAT=text
